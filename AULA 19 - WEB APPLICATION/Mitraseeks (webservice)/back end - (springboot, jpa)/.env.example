# Copie este arquivo para .env e preencha com seus valores (o .env não vai para o git)

# PostgreSQL usado pelo application.properties
DB_HOST=localhost:5432
DB_NAME=mitraseeks
DB_USER=postgres
DB_PASSWORD=

# Conta de admin criada ao subir o back (AdminInicializador)
ADMIN_USUARIO=admin
ADMIN_EMAIL=admin@mitraseeks.local
ADMIN_SENHA=

# APIs externas: o código lê estas duas com System.getenv(), então defina como
# variáveis de ambiente do sistema (ou na configuração de execução do IntelliJ),
# não só neste arquivo.
# OMDB_API_KEY=
# OPENAI_APIKEY=
